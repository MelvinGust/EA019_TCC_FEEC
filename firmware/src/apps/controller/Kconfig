menu "Controller Module Configuration"

    config CONTROLLER_UART_RX_TASK_STACK_SIZE
        int "UART RX task stack size"
        range 1024 16384
        default 3072
        help
            Defines stack size for UART task.

    config CONTROLLER_UART_RX_TASK_PRIORITY
        int "UART RX task priority"
        range 1 10
        default 10
        help
            Defines task priority for the data reception UART task. 
            Should be of higher priority than the process task.

        config CONTROLLER_UART_PROCESS_STACK_SIZE
            int "Controller module task stack size"
            range 1024 16384
            default 4096
            help
                Defines stack size for the data processing UART task.

        config CONTROLLER_UART_PROCESS_TASK_PRIORITY
        int "UART PROCESS task priority"
        range 1 10
        default 9
        help
            Defines the task priority for the data processing UART task.

    config CONTROLLER_FREQUENCY
        int "Controller Tick Timer frequency"
        range 1 1000
        default 100
        help
            Defines the frequency at which the controller will "update" and send data to the plant.

    config CONTROLLER_DEBUG_LOG_ENABLED
        bool "Plant debug log flag"
        default n
        help
            If true, enables ESP logging with verbosity DEBUG.
    
endmenu