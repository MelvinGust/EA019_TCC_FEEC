    {
        "id": "e5682f81",
        "type": "function",
        "z": "35ad271e",
        "name": "Publish and remember reference",
        "func": "const reference = Number(msg.payload);\nif (!Number.isFinite(reference)) { node.warn(\"Reference must be a finite number\"); return null; }\nflow.set(\"ctrl_ref\", reference);\nreturn [\n  {topic: \"ctrl/ref\", payload: String(reference)},\n];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
