        "id": "f3bb88f0c62cc326",
        "type": "function",
        "z": "35ad271e",
        "name": "Update reference for graph",
        "func": "const reference = flow.get(\"ctrl_ref\");\n\nif (reference === undefined) {\n    return null;\n}\n\nmsg.topic = \"Reference\";\nmsg.payload = reference;\nmsg.timestamp = Date.now();\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
