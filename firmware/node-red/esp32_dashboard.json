    {
        "id": "8f69359b",
        "type": "function",
        "z": "35ad271e",
        "name": "Parse Controller State",
        "func": "let d = msg.payload;\nif (typeof d === \"string\") { try { d = JSON.parse(d); } catch (e) { node.warn(\"Invalid JSON on ctrl/state\"); return null; } }\nif (!d || ![\"K_p\", \"K_i\", \"u\", \"x_i\"].every(k => typeof d[k] === \"number\" && Number.isFinite(d[k]))) { node.warn(\"Unexpected ctrl/state payload\"); return null; }\nconst ts = Date.now();\nreturn [\n  {topic: \"Controller Output\", payload: d.u, timestamp: ts},\n  {payload: d.K_p},\n  {payload: d.K_i},\n  {payload: d.x_i}\n];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 120,
        "wires": [
            [
                "eab89c7e"
            ],
            [
                "4201910c"
            ],
            [
                "011a0e1b"
            ],
            [
                "36b2c4d2"
            ]
        ]
    },
    {
        "id": "65ba38e3",
        "type": "function",
        "z": "35ad271e",
        "name": "Parse Plant State",
        "func": "let d = msg.payload;\nif (typeof d === \"string\") { try { d = JSON.parse(d); } catch (e) { node.warn(\"Invalid JSON on plant/state\"); return null; } }\nif (!d || ![\"y\", \"x_b\", \"x_m\", \"x_o\"].every(k => typeof d[k] === \"number\" && Number.isFinite(d[k]))) { node.warn(\"Unexpected plant/state payload\"); return null; }\nreturn [\n  {topic: \"Plant Output\", payload: d.y, timestamp: Date.now()},\n  {payload: d.x_b},\n  {payload: d.x_m},\n  {payload: d.x_o}\n];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 420,
        "wires": [
